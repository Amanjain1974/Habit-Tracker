# PostgreSQL database connection string (e.g. from InsForge, Supabase, or Neon)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth configuration
NEXTAUTH_SECRET="your_nextauth_secret_minimum_32_characters_random_string"
NEXTAUTH_URL="https://your-production-url.onrender.com"
