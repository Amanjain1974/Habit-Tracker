generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  mobile        String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tasks         Task[]
  habits        Habit[]
  goals         Goal[]
  timeLogs      TimeLog[]
  accounts      Account[]
  sessions      Session[]
  categories    Category[]
  journalEntries JournalEntry[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id        String   @id @default(cuid())
  name      String
  color     String   
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())

  tasks     Task[]
  habits    Habit[]
  goals     Goal[]
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  
  matrixColumn Int      @default(2) // 1: Do, 2: Schedule, 3: Delegate, 4: Delete
  
  priority    String?   // HIGH, MEDIUM, LOW
  deadline    DateTime?
  estimatedDuration Int? 
  actualDuration    Int? 
  
  status      String    @default("TODO") 
  
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  postponeCount Int     @default(0)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  goalId      String?
  goal        Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)
  
  habitId     String?
  habit       Habit?    @relation(fields: [habitId], references: [id], onDelete: SetNull)
}

model Habit {
  id          String    @id @default(cuid())
  title       String
  
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  frequency   String    // DAILY, WEEKLY, CUSTOM
  customDays  String?   
  targetCount Int?      
  
  startDate   DateTime?
  endDate     DateTime?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  goalId      String?
  goal        Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)

  tasks       Task[]
  logs        HabitLog[]
}

model HabitLog {
  id          String    @id @default(cuid())
  habitId     String
  habit       Habit     @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date        DateTime  
  completed   Boolean   @default(true)
  
  createdAt   DateTime  @default(now())
  
  @@unique([habitId, date])
}

model Goal {
  id          String    @id @default(cuid())
  title       String
  description String?
  level       String    
  targetDate  DateTime?
  progress    Int       @default(0) 
  status      String    @default("ACTIVE") 

  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  tasks       Task[]
  habits      Habit[]
  milestones  GoalMilestone[]
}

model GoalMilestone {
  id        String   @id @default(cuid())
  title     String
  done      Boolean  @default(false)
  
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
}

model TimeLog {
  id          String    @id @default(cuid())
  activity    String
  startTime   DateTime
  endTime     DateTime?
  duration    Int?      
  category    String?
  productivityRating Int? 
  notes       String?

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime  @default(now())
}

model JournalEntry {
  id        String   @id @default(cuid())
  date      DateTime
  content   String
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@unique([userId, date])
}
